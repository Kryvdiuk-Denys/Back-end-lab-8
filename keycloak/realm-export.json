{
  "realm": "coworking",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "MANAGER" },
      { "name": "USER" }
    ]
  },
  "clients": [
    {
      "clientId": "coworking-ui",
      "name": "Coworking UI (OIDC authorization code)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ui-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8080/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ],
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [ "http://localhost:8080" ]
    },
    {
      "clientId": "coworking-api",
      "name": "Coworking API (JWT for curl/Postman)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@coworking.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": [ "ADMIN" ]
    },
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@coworking.local",
      "firstName": "Manager",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "manager", "temporary": false }
      ],
      "realmRoles": [ "MANAGER" ]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@coworking.local",
      "firstName": "Regular",
      "lastName": "User",
      "credentials": [
        { "type": "password", "value": "user", "temporary": false }
      ],
      "realmRoles": [ "USER" ]
    }
  ]
}
